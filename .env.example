# Copy to .env.local for local dev. In Vercel, set these in Project Settings > Environment Variables.

# Anthropic API key (Claude Console). Required.
ANTHROPIC_API_KEY=

# Model for search and Ask. Defaults to claude-sonnet-5-5.
MODEL=claude-sonnet-5-5

# Passcode Ella types to get in. Set it in Vercel only; never commit it.
APP_PASSCODE=

# Separate passcode for Tom's /admin page (Notion sign-in, forced token refresh).
ADMIN_PASSCODE=

# Random secret for signing login cookies. Generate like TOKEN_ENCRYPTION_KEY.
SESSION_SECRET=

# 32-byte key, base64, for encrypting stored Notion tokens.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Where Notion OAuth tokens and the dossier cache live in production (Upstash Redis / Vercel KV).
# Leave blank locally: tokens go to .data/ (encrypted, gitignored).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL of the app, used for the Notion OAuth redirect. Locally: http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Fathom API key (Fathom > Settings > API Access). Optional: lets the meeting-summary button
# fall back to Fathom recordings when Notion has no summary.
FATHOM_API_KEY=

# Fallback path only: read-only Notion integration token for the self-hosted MCP server.
NOTION_TOKEN=
